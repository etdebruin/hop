#compdef hop
# zsh completion for hop. Put this directory on your fpath.

local -a names
local state

_arguments -C -s \
  '(-a --all)'{-a,--all}'[offer every match, not just the ones nearest a root]' \
  '(-i --browse)'{-i,--browse}'[browse every directory, filtering as you type]' \
  '(-l --list)'{-l,--list}'[list matching directories instead of jumping]' \
  '(-d --depth)'{-d,--depth}'[how deep to descend]:depth:' \
  '--roots[print the directories hop searches]' \
  '(-h --help)'{-h,--help}'[show help]' \
  '(-V --version)'{-V,--version}'[show the version]' \
  '1:directory:->names' && return 0

case "$state" in
  names)
    names=(${(f)"$(_hop_candidates 2>/dev/null)"})
    # compadd rather than _describe: the names carry no descriptions, so
    # _describe's extra machinery is a few milliseconds spent on nothing --
    # and this runs on a keystroke.
    _wanted directories expl 'directory' compadd -a names
    ;;
esac
